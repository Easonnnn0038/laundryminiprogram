<view class="page">
  <view class="masthead">
    <text class="brand">小木棒洗衣</text>
    <view class="title">衣服到哪儿了，打开就知道。</view>
    <view class="subtitle">进度、取衣码和门店联系方式，都在这里。</view>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}<button class="retry" bindtap="retry">重试</button></view>
  <view wx:if="{{loading}}" class="loading">正在同步订单…</view>

  <view wx:elif="{{!bound}}" class="surface bind-box">
    <view class="bind-title">先确认是您本人</view>
    <view class="subtitle">绑定微信验证的手机号后，才能安全查看与该号码关联的订单。</view>
    <button class="primary bind-button" open-type="getPhoneNumber" bindgetphonenumber="bindPhone">绑定手机号</button>
  </view>

  <block wx:elif="{{orders.length}}">
    <view class="section-title">正在进行</view>
    <view wx:for="{{orders}}" wx:key="id" class="surface order" bindtap="openOrder" data-id="{{item.id}}" aria-role="button" aria-label="查看订单 {{item.orderNo}}，当前{{item.statusLabel}}">
      <view class="order-top">
        <view><text class="status">{{item.statusLabel}}</text><text wx:if="{{item.urgent}}" class="tag">加急</text></view>
        <text class="arrow">›</text>
      </view>
      <view wx:if="{{item.pickupCode}}" class="pickup">
        <text class="pickup-label">取衣码</text>
        <text class="pickup-code">{{item.pickupCode}}</text>
      </view>
      <view class="order-meta">{{item.totalCount}} 件衣物 · {{item.storeName}}</view>
      <view class="order-no">{{item.orderNo}}</view>
      <view class="time">{{item.receiveTime}}</view>
    </view>
    <button class="secondary all-button" bindtap="openOrders">查看全部订单</button>
  </block>

  <view wx:else class="surface empty">
    <view class="empty-title">暂时没有进行中的订单</view>
    <view>门店收衣后，订单会自动出现在这里。</view>
  </view>
</view>
