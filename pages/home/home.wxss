play:flex;align-items:center;margin-top:28rpx;padding:26rpx 28rpx;border-top:1rpx solid #d9ded9;border-bottom:1rpx solid #d9ded9}.note-mark{display:flex;align-items:center;justify-content:center;width:50rpx;height:50rpx;margin-right:18rpx;border-radius:50%;background:#f4cf66;color:#173f35;font-weight:900}.service-note strong,.service-note view>text{display:block}.service-note strong{font-size:27rpx}.service-note view>text{margin-top:5rpx;color:#65736d;font-size:22rpx}
