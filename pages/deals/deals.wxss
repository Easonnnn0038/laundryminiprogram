.deals-page{padding-top:34rpx}.deal-list{margin-top:36rpx;border-top:1rpx solid #d9e4f2}.deal-row{display:flex;gap:24rpx;padding:28rpx 0;border-bottom:1rpx solid #d9e4f2}.deal-art{position:relative;width:184rpx;height:184rpx;flex-shrink:0;overflow:hidden;border-radius:20rpx;background:#edf4ff}.deal-sheet{position:absolute;width:400%;height:300%;max-width:none}.d00{left:0;top:0}.d10{left:-100%;top:0}.d20{left:-200%;top:0}.d30{left:-300%;top:0}.d01{left:0;top:-100%}.d11{left:-100%;top:-100%}.d21{left:-200%;top:-100%}.d31{left:-300%;top:-100%}.d02{left:0;top:-200%}.deal-main{min-width:0;flex:1}.deal-main>strong,.deal-main>text{display:block;overflow-wrap:anywhere}.deal-main>strong{font-size:29rpx;line-height:1.35}.deal-main>text{margin-top:10rpx;color:#5e6f89;font-size:23rpx;line-height:1.45}.deal-bottom{display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:14rpx;margin-top:24rpx}.price{color:#155eef;font-size:36rpx;font-weight:850}.price>text{margin-right:2rpx;font-size:23rpx}.price del{margin-left:8rpx;color:#7b8aa0;font-size:21rpx;font-weight:400}.deal-bottom button{min-width:156rpx;width:auto;height:auto;min-height:66rpx;margin:0;padding:0 16rpx;border-radius:14rpx;font-size:24rpx;line-height:1.35}.rules{margin-top:34rpx;padding:24rpx 0;border-top:1rpx solid #d9e4f2;color:#5e6f89;font-size:23rpx;line-height:1.6}
