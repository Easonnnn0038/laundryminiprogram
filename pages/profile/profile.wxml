<view class="page">
  <view class="title">我的</view>
  <view class="subtitle">管理手机号、联系人和常用上门地址。</view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="retry" bindtap="load">重试</button></view>
  <view wx:if="{{loading}}" class="loading-shell" aria-label="正在加载账户">
    <view class="loading-profile"><view class="loading-block loading-avatar"></view><view class="loading-block loading-name"></view></view>
    <view class="loading-block loading-member"></view>
    <view class="loading-block loading-menu"></view>
    <view class="loading-hint">正在读取账户信息…</view>
  </view>
  <view wx:elif="{{closed}}" class="empty">账户已注销。需要再次使用服务时，可重新开通。<button class="primary reopen" bindtap="reopenAccount">重新开通</button></view>
  <block wx:else>
  <view class="identity">
    <image class="avatar" src="/assets/brand-logo.png" mode="aspectFit" aria-label="小木棒洗衣标志" />
    <view><view class="identity-title">顾客账户</view><view class="subtitle">{{authenticated ? (bound ? phone : '尚未绑定手机号') : '尚未登录'}}</view></view>
  </view>
  <button wx:if="{{!bound}}" class="primary bind" bindtap="goLogin">登录并绑定手机号</button>
  <block wx:if="{{bound}}">
    <view wx:if="{{memberError}}" class="member-error"><text>{{memberError}}</text><button bindtap="load">重新加载</button></view>
    <view wx:elif="{{memberCard && memberCard.active}}" class="member-card">
      <view class="card-head"><view><text class="card-type">{{memberCard.cardTypeName}}</text><text class="card-no">{{memberCard.cardNo}}</text></view><text class="card-status">使用中</text></view>
      <view class="balance-label">卡内余额</view>
      <view class="balance"><text>¥</text>{{memberCard.balanceText}}</view>
      <view class="card-foot"><view><text>累计消费</text><strong>¥{{memberCard.totalConsumeText}}</strong></view><button bindtap="recharge">充值</button></view>
    </view>
    <view wx:elif="{{memberCard}}" class="no-card"><view><strong>暂无会员卡</strong><text>会员卡需在门店办理，绑定手机号后会自动显示。</text></view></view>
  </block>
  <view class="menu">
    <view bindtap="openAddresses" aria-role="button" aria-label="管理联系人与地址"><text>联系人与地址</text><text class="hint">›</text></view>
    <view bindtap="showPrivacy" aria-role="button" aria-label="查看隐私说明"><text>隐私说明</text><text class="hint">›</text></view>
    <view bindtap="showDeletion" aria-role="button" aria-label="申请删除个人资料或注销账户"><text>个人资料与注销</text><text class="hint">›</text></view>
  </view>
  <button wx:if="{{authenticated}}" class="logout-button" disabled="{{loggingOut}}" bindtap="logout">退出登录</button>
  </block>
  <view class="foot">小木棒洗衣 · 顾客服务</view>
</view>
