<view class="page">
  <view class="title">我的</view>
  <view class="subtitle">管理手机号、联系人和常用上门地址。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="empty">正在读取账户信息…</view>
  <block wx:else>
  <view class="identity">
    <view class="avatar">木</view>
    <view><view class="identity-title">微信顾客</view><view class="subtitle">{{bound ? phone : '尚未绑定手机号'}}</view></view>
  </view>
  <button wx:if="{{!bound}}" class="primary bind" open-type="getPhoneNumber" bindgetphonenumber="bindPhone">绑定手机号</button>
  <view class="menu">
    <view bindtap="openAddresses" aria-role="button" aria-label="管理联系人与地址"><text>联系人与地址</text><text class="hint">›</text></view>
    <view bindtap="showPrivacy" aria-role="button" aria-label="查看隐私说明"><text>隐私说明</text><text class="hint">›</text></view>
  </view>
  </block>
  <view class="foot">小木棒洗衣 · 顾客服务</view>
</view>
