.identity { display: flex; align-items: center; margin-top: 52rpx; padding: 34rpx 0; }
.avatar { width: 96rpx; height: 96rpx; margin-right: 24rpx; border-radius: 24rpx; background: #fff; }
.identity-title { font-size: 34rpx; font-weight: 760; }
.bind { margin: 10rpx 0 38rpx; }
.member-error { display: flex; align-items: center; justify-content: space-between; margin-top: 24rpx; padding: 26rpx 4rpx; border-top: 1rpx solid #d9e4f2; border-bottom: 1rpx solid #d9e4f2; color: #813b25; }
.member-error button { width: auto; height: auto; margin: 0; padding: 0; background: transparent; color: #155eef; font-size: 25rpx; line-height: 1.5; text-decoration: underline; }
.member-card { margin-top: 24rpx; padding: 34rpx; border-radius: 26rpx; background: #154ea8; color: #fff; }
.card-head { display: flex; align-items: flex-start; justify-content: space-between; }
.card-type, .card-no { display: block; }
.card-type { font-size: 31rpx; font-weight: 800; }
.card-no { margin-top: 8rpx; color: #d7e6ff; font-family: ui-monospace, monospace; font-size: 22rpx; letter-spacing: 1rpx; }
.card-status { padding: 5rpx 12rpx; border-radius: 8rpx; background: #dceaff; color: #164e9c; font-size: 20rpx; font-weight: 800; }
.balance-label { margin-top: 40rpx; color: #d7e6ff; font-size: 23rpx; }
.balance { margin-top: 2rpx; font-size: 62rpx; font-weight: 850; letter-spacing: -2rpx; }
.balance text { margin-right: 6rpx; font-size: 30rpx; font-weight: 700; }
.card-foot { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 36rpx; padding-top: 24rpx; border-top: 1rpx solid #4f7bc1; }
.card-foot view text, .card-foot view strong { display: block; }
.card-foot view text { color: #d7e6ff; font-size: 21rpx; }
.card-foot view strong { margin-top: 5rpx; font-size: 27rpx; }
.card-foot button { width: 180rpx; height: 68rpx; margin: 0; border-radius: 14rpx; background: #fff; color: #154ea8; font-size: 27rpx; line-height: 68rpx; }
.no-card { margin-top: 24rpx; padding: 30rpx 4rpx; border-top: 1rpx solid #d9e4f2; border-bottom: 1rpx solid #d9e4f2; }
.no-card strong, .no-card text { display: block; }
.no-card text { margin-top: 8rpx; color: #5e6f89; font-size: 24rpx; line-height: 1.55; }
.menu { margin-top: 36rpx; border-top: 1rpx solid #d9e4f2; }
.menu > view { display: flex; justify-content: space-between; padding: 34rpx 4rpx; border-bottom: 1rpx solid #d9e4f2; font-weight: 650; }
.hint { color: #66758c; font-weight: 400; }
.foot { margin-top: 100rpx; text-align: center; color: #7b8aa0; font-size: 23rpx; }
.reopen { margin-top: 28rpx; min-height: 84rpx; line-height: 84rpx; }
.logout-button { height: 84rpx; margin-top: 40rpx; border: 1rpx solid #d9e4f2; background: #fff; color: #5e6f89; font-size: 27rpx; line-height: 82rpx; }
