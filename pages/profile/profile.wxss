.identity { display: flex; align-items: center; margin-top: 52rpx; padding: 34rpx 0; }
.avatar { display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; margin-right: 24rpx; border-radius: 24rpx; background: #173f35; color: #fff; font-size: 42rpx; font-weight: 800; }
.identity-title { font-size: 34rpx; font-weight: 760; }
.bind { margin: 10rpx 0 38rpx; }
.menu { margin-top: 36rpx; border-top: 1rpx solid #d7ddd8; }
.menu > view { display: flex; justify-content: space-between; padding: 34rpx 4rpx; border-bottom: 1rpx solid #d7ddd8; font-weight: 650; }
.hint { color: #738079; font-weight: 400; }
.foot { margin-top: 100rpx; text-align: center; color: #89928d; font-size: 23rpx; }
