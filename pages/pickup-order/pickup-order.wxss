.catalog-page{padding-bottom:210rpx}.heading{display:flex;align-items:flex-end;justify-content:space-between}.step{color:#7b8aa0;font-family:ui-monospace,monospace;font-size:23rpx}.group-tabs{width:calc(100% + 64rpx);margin:42rpx 0 20rpx -32rpx;white-space:nowrap}.group-tabs-inner{display:inline-flex;gap:12rpx;padding:0 32rpx}.group-tab{display:inline-block;width:auto;height:70rpx;padding:0 26rpx;line-height:70rpx;border:1rpx solid #cbd9ec;border-radius:35rpx;background:transparent;color:#3f5878;font-size:26rpx}.group-tab.active{border-color:#155eef;background:#155eef;color:#fff}.member-note{margin-bottom:12rpx;color:#5e6f89;font-size:23rpx}.member-note text{margin-right:10rpx;padding:5rpx 10rpx;border-radius:6rpx;background:#dceaff;color:#164e9c;font-weight:800}.catalog{border-top:1rpx solid #cbd9ec}.catalog-row{display:flex;align-items:center;justify-content:space-between;min-height:96rpx;padding:23rpx 4rpx;border-bottom:1rpx solid #dfe7f2}.garment{min-width:0;padding-right:16rpx}.garment>view{font-weight:750}.garment>text{display:block;margin-top:7rpx;color:#5e6f89;font-size:24rpx}.original{margin-left:8rpx;text-decoration:line-through}.counter{display:flex;align-items:center;gap:14rpx;flex-shrink:0}.counter button{width:62rpx;height:62rpx;padding:0;line-height:62rpx;border:1rpx solid #cbd9ec;border-radius:50%;background:#fff;color:#155eef}.counter text{min-width:32rpx;text-align:center;font-weight:800}.price-note{margin-top:22rpx;text-align:center;color:#6f7f95;font-size:22rpx}.checkout-bar{position:fixed;z-index:20;left:0;right:0;bottom:0;display:flex;align-items:center;gap:24rpx;padding:18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid #d9e4f2;background:#fff}.checkout-total{min-width:0;flex:1}.checkout-total strong,.checkout-total text{display:block}.checkout-total strong{font-size:31rpx;color:#172b4d}.checkout-total text{margin-top:5rpx;color:#5e6f89;font-size:22rpx}.checkout-button{width:248rpx;height:80rpx;margin:0;line-height:80rpx;font-size:28rpx}
.deal-banner{position:relative;margin-top:34rpx;padding:26rpx 28rpx;border-radius:22rpx;background:#e8f1ff;color:#172b4d}.deal-banner text,.deal-banner strong{display:block}.deal-banner text{color:#155eef;font-size:21rpx;font-weight:800}.deal-banner strong{max-width:480rpx;margin-top:6rpx;font-size:29rpx}.deal-banner-price{position:absolute;right:28rpx;top:29rpx;color:#155eef;font-size:34rpx;font-weight:850}.deal-banner-note{margin-top:16rpx;color:#52657f;font-size:22rpx;line-height:1.5}.deal-banner+.group-tabs{margin-top:28rpx}
