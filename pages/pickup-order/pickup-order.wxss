.catalog-page{padding-bottom:210rpx}.heading{display:flex;align-items:flex-end;justify-content:space-between}.step{color:#8b948f;font-family:ui-monospace,monospace;font-size:23rpx}.group-tabs{width:calc(100% + 64rpx);margin:42rpx 0 20rpx -32rpx;white-space:nowrap}.group-tabs-inner{display:inline-flex;gap:12rpx;padding:0 32rpx}.group-tab{display:inline-block;width:auto;height:70rpx;padding:0 26rpx;line-height:70rpx;border:1rpx solid #d5ddd7;border-radius:35rpx;background:transparent;color:#35554c;font-size:26rpx}.group-tab.active{border-color:#173f35;background:#173f35;color:#fff}.member-note{margin-bottom:12rpx;color:#65736d;font-size:23rpx}.member-note text{margin-right:10rpx;padding:5rpx 10rpx;border-radius:6rpx;background:#f4cf66;color:#4e3a00;font-weight:800}.catalog{border-top:1rpx solid #ccd4cf}.catalog-row{display:flex;align-items:center;justify-content:space-between;min-height:96rpx;padding:23rpx 4rpx;border-bottom:1rpx solid #dbe0dc}.garment{min-width:0;padding-right:16rpx}.garment>view{font-weight:750}.garment>text{display:block;margin-top:7rpx;color:#65736d;font-size:24rpx}.original{margin-left:8rpx;text-decoration:line-through}.counter{display:flex;align-items:center;gap:14rpx;flex-shrink:0}.counter button{width:62rpx;height:62rpx;padding:0;line-height:62rpx;border:1rpx solid #cbd8d1;border-radius:50%;background:#fffefa;color:#173f35}.counter text{min-width:32rpx;text-align:center;font-weight:800}.price-note{margin-top:22rpx;text-align:center;color:#7b8681;font-size:22rpx}.checkout-bar{position:fixed;z-index:20;left:0;right:0;bottom:0;display:flex;align-items:center;gap:24rpx;padding:18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e0e4df;background:#fffefa}.checkout-total{min-width:0;flex:1}.checkout-total strong,.checkout-total text{display:block}.checkout-total strong{font-size:31rpx;color:#173f35}.checkout-total text{margin-top:5rpx;color:#65736d;font-size:22rpx}.checkout-button{width:248rpx;height:80rpx;margin:0;line-height:80rpx;font-size:28rpx}
