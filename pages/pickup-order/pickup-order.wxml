<view class="page catalog-page">
  <view class="heading"><view><view class="title">选择衣物</view><view class="subtitle">可跨分类添加，数量稍后仍可调整</view></view><view class="step">02 / 03</view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{loading}}" class="empty">正在读取价目…</view>
  <block wx:else>
    <scroll-view class="group-tabs" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="group-tabs-inner"><button wx:for="{{groups}}" wx:key="key" class="group-tab {{activeGroup === item.key ? 'active' : ''}}" data-group="{{item.key}}" bindtap="selectGroup">{{item.label}}</button></view>
    </scroll-view>
    <view wx:if="{{memberCardType}}" class="member-note"><text>会员</text>{{memberCardType}}价格已自动计算</view>
    <view class="catalog">
      <view wx:for="{{visibleCatalog}}" wx:key="id" class="catalog-row">
        <view class="garment"><view>{{item.name}}</view><text>¥{{item.price}} / {{item.unit}}{{item.remark}} <text wx:if="{{item.member && item.price < item.originalPrice}}" class="original">¥{{item.originalPrice}}</text></text></view>
        <view class="counter"><button data-id="{{item.id}}" data-delta="-1" bindtap="changeQuantity" aria-label="减少{{item.name}}数量">−</button><text>{{item.quantity}}</text><button data-id="{{item.id}}" data-delta="1" bindtap="changeQuantity" aria-label="增加{{item.name}}数量">＋</button></view>
      </view>
    </view>
    <view class="price-note">页面为预估价，门店验衣后确认最终费用</view>
    <view class="checkout-bar">
      <view class="checkout-total"><strong>{{count}} 件 · ¥{{total}}</strong><text wx:if="{{count && discount !== '0.00'}}">会员已省 ¥{{discount}}</text><text wx:else>免费上门取送</text></view>
      <button class="primary checkout-button" disabled="{{!count}}" bindtap="next">确认衣物</button>
    </view>
  </block>
</view>
