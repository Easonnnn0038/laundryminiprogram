<view class="login-page">
  <view class="login-top">
    <image class="logo" src="/assets/brand-logo.png" mode="aspectFit" aria-label="小木棒洗衣标志" />
    <text class="brand">小木棒洗衣</text>
  </view>
  <image class="hero" src="/assets/home-hero.jpg" mode="aspectFill" />
  <view class="content">
    <view class="headline">欢迎回来</view>
    <view class="description">登录后查看订单与洗护进度，也可以预约上门取衣。</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <view wx:if="{{loading}}" class="status">正在准备服务…</view>
    <button wx:elif="{{closed}}" class="primary action" bindtap="reopenAccount">重新开通账户</button>
    <button wx:elif="{{demo}}" class="primary action" bindtap="enterDemo">进入演示</button>
    <button wx:elif="{{wechatMode}}" class="primary action" open-type="getPhoneNumber" bindgetphonenumber="bindPhone" loading="{{submitting}}" disabled="{{submitting}}">微信手机号快捷登录</button>
    <block wx:else>
      <view class="mode-tabs">
        <view class="mode-tab {{mode === 'password' ? 'active' : ''}}" data-mode="password" bindtap="changeMode" aria-role="button">密码登录</view>
        <view class="mode-tab {{mode === 'sms' ? 'active' : ''}}" data-mode="sms" bindtap="changeMode" aria-role="button">验证码登录</view>
      </view>
      <view wx:if="{{mode === 'register'}}" class="form-title">手机号注册</view>
      <view class="field"><text>手机号</text><input type="number" maxlength="11" value="{{phone}}" bindinput="inputPhone" placeholder="请输入手机号" /></view>
      <view wx:if="{{mode === 'password'}}" class="field"><text>密码</text><input password="{{true}}" value="{{password}}" bindinput="inputPassword" placeholder="请输入密码" /></view>
      <view wx:else class="field"><text>短信验证码</text><view class="code-row"><input type="number" maxlength="6" value="{{code}}" bindinput="inputCode" placeholder="请输入验证码" /><text>暂未开通</text></view></view>
      <button wx:if="{{mode === 'password'}}" class="primary action" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitPassword">登录</button>
      <button wx:else class="primary action unavailable" disabled="{{true}}">{{mode === 'register' ? '注册（短信服务开通后可用）' : '验证码登录（暂未开通）'}}</button>
      <view class="form-footer">
        <text wx:if="{{mode !== 'register'}}" data-mode="register" bindtap="changeMode">没有账号？去注册</text>
        <text wx:else data-mode="password" bindtap="changeMode">已有账号？去登录</text>
      </view>
      <view class="future-note">短信服务开通后支持验证码登录和注册；微信手机号一键登录将在备案和相关服务就绪后开放。</view>
    </block>
    <view class="privacy" bindtap="goPrivacy" aria-role="button" aria-label="查看隐私说明">查看隐私说明　›</view>
  </view>
</view>
