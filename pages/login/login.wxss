.login-page { min-height: 100vh; background: #dff8fa; color: #17354c; }
.login-stage { position: relative; width: 750rpx; height: 1332rpx; margin: 0 auto; }
.scene { display: block; width: 750rpx; height: 1332rpx; }
.mode-tabs, .register-heading { position: absolute; top: 736rpx; left: 207rpx; width: 508rpx; height: 53rpx; display: flex; align-items: center; justify-content: space-around; box-sizing: border-box; border-radius: 14rpx; background: rgba(237, 252, 252, .96); }
.mode-tab { padding: 9rpx 8rpx; color: #3f6477; font-size: 26rpx; font-weight: 600; }
.mode-tab.active { color: #006c9b; border-bottom: 4rpx solid #009dc4; }
.register-heading { justify-content: space-between; padding: 0 22rpx; font-size: 27rpx; font-weight: 700; }
.back-login { color: #006c9b; font-size: 24rpx; font-weight: 500; }
.input-slot { position: absolute; left: 205rpx; width: 515rpx; height: 109rpx; display: flex; align-items: center; box-sizing: border-box; }
.phone-slot { top: 797rpx; }
.secret-slot { top: 982rpx; }
.input-slot input { width: 100%; height: 100%; box-sizing: border-box; padding: 0 37rpx; background: transparent; color: #17354c; font-size: 29rpx; }
.input-placeholder { color: #526c7d; }
.code-slot input { padding-right: 0; }
.code-unavailable { flex: none; margin-right: 31rpx; color: #577587; font-size: 22rpx; }
.access-note { position: absolute; top: 814rpx; left: 245rpx; width: 440rpx; color: #31596d; font-size: 27rpx; line-height: 70rpx; text-align: center; }
.login-error { position: absolute; top: 1100rpx; left: 205rpx; width: 515rpx; box-sizing: border-box; color: #8b352c; font-size: 23rpx; line-height: 32rpx; text-align: center; }
.login-action { position: absolute; top: 1176rpx; left: 205rpx; width: 515rpx; height: 90rpx; margin: 0; padding: 0 12rpx; border-radius: 45rpx; background: #087da9; box-shadow: 0 10rpx 20rpx rgba(3, 96, 135, .18); color: #fff; font-size: 30rpx; font-weight: 700; line-height: 90rpx; }
.login-action.unavailable, .login-action[disabled] { background: #7b9eaa; color: #fff; box-shadow: none; }
.login-footer { padding: 0 42rpx 52rpx; padding-bottom: calc(52rpx + env(safe-area-inset-bottom)); text-align: center; }
.form-footer { padding: 0 0 26rpx; color: #006f9d; font-size: 27rpx; font-weight: 600; }
.description { color: #36596a; font-size: 24rpx; line-height: 1.5; }
.future-note { margin-top: 16rpx; color: #496a79; font-size: 22rpx; line-height: 1.5; }
.privacy { margin-top: 26rpx; color: #006f9d; font-size: 24rpx; }
