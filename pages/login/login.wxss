.login-page{min-height:100vh;box-sizing:border-box;padding:20rpx 32rpx 64rpx;background:#f5f8ff}.login-top{display:flex;align-items:center;gap:18rpx;padding:12rpx 4rpx 24rpx}.logo{width:70rpx;height:70rpx;border-radius:16rpx;background:#fff}.brand{font-size:29rpx;font-weight:800}.hero{display:block;width:100%;height:250rpx;border-radius:24rpx;background:#dceaff}.content{padding:36rpx 8rpx 0}.headline{font-size:52rpx;line-height:1.2;font-weight:800}.description{margin-top:12rpx;color:#5e6f89;font-size:25rpx;line-height:1.55}.status{margin-top:50rpx;color:#5e6f89;text-align:center}.mode-tabs{display:flex;gap:42rpx;margin-top:34rpx;border-bottom:1rpx solid #d9e4f2}.mode-tab{padding:0 0 18rpx;color:#5e6f89;font-size:28rpx;font-weight:650}.mode-tab.active{border-bottom:4rpx solid #155eef;color:#155eef}.form-title{margin-top:26rpx;font-size:30rpx;font-weight:750}.field{margin-top:28rpx}.field>text{display:block;margin-bottom:12rpx;color:#172b4d;font-size:25rpx;font-weight:650}.field input{height:82rpx;padding:0 22rpx;border:1rpx solid #d9e4f2;border-radius:14rpx;background:#fff;font-size:28rpx;box-sizing:border-box}.code-row{display:flex;align-items:center;gap:18rpx}.code-row input{flex:1;min-width:0}.code-row text{color:#6f7f95;font-size:24rpx}.action{height:88rpx;margin-top:36rpx;line-height:88rpx;font-size:29rpx}.unavailable{background:#aab7cc;color:#fff}.form-footer{margin-top:28rpx;color:#155eef;font-size:25rpx;text-align:center}.future-note{margin-top:30rpx;color:#5e6f89;font-size:23rpx;line-height:1.6}.privacy{margin-top:32rpx;color:#155eef;font-size:24rpx;text-align:center}.error{margin:24rpx 0 0}
