<view class="page">
  <view class="title">我的订单</view>
  <view class="tabs" role="tablist">
    <view class="tab {{tab === 'current' ? 'active' : ''}}" data-tab="current" bindtap="selectTab" aria-role="tab" aria-label="进行中订单">进行中</view>
    <view class="tab {{tab === 'history' ? 'active' : ''}}" data-tab="history" bindtap="selectTab" aria-role="tab" aria-label="历史订单">历史订单</view>
    <view class="tab {{tab === 'pickup' ? 'active' : ''}}" data-tab="pickup" bindtap="selectTab" aria-role="tab" aria-label="上门预约">上门预约</view>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="retry" bindtap="load">重试</button></view>
  <view wx:if="{{loading}}" class="loading-shell" aria-label="正在加载订单">
    <view class="loading-block loading-row"></view>
    <view class="loading-block loading-row"></view>
    <view class="loading-block loading-row"></view>
    <view class="loading-hint">正在读取订单…</view>
  </view>
  <view wx:elif="{{!bound}}" class="surface empty"><view>登录后查看您的订单。</view><button class="secondary small" bindtap="goLogin">前往登录</button></view>
  <view wx:elif="{{!orders.length}}" class="surface empty">{{tab === 'current' ? '没有进行中的订单' : tab === 'pickup' ? '还没有上门预约' : '还没有历史订单'}}</view>
  <block wx:else>
    <view wx:for="{{orders}}" wx:key="id" class="order-row" bindtap="openOrder" data-id="{{item.id}}" aria-role="button" aria-label="订单当前{{item.statusLabel}}">
      <view class="row-main"><text class="status">{{item.statusLabel}}</text><text wx:if="{{item.urgent}}" class="tag">加急</text></view>
      <view wx:if="{{item.statusHint}}" class="status-hint">{{item.statusHint}}</view>
      <view wx:if="{{tab === 'pickup'}}" class="meta">{{item.appointmentDate}} {{item.appointmentSlot}}</view>
      <view wx:else class="meta">{{item.totalCount}} 件 · {{item.storeName}}</view>
      <view wx:if="{{tab === 'pickup'}}" class="bottom"><text>{{item.pickupAddress}}</text><text>¥{{item.paidAmount || item.estimatedAmount}}</text></view>
      <view wx:else class="bottom"><text class="mono">{{item.orderNo}}</text><text>{{item.receiveTime}}</text></view>
    </view>
  </block>
</view>
