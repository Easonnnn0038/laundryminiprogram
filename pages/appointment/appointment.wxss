.appointment-page{padding-bottom:210rpx}.heading{display:flex;align-items:flex-end;justify-content:space-between}.step{color:#7b8aa0;font-family:ui-monospace,monospace;font-size:23rpx}.address-card{position:relative;padding:30rpx}.address-main{padding-right:170rpx}.address-main strong{font-size:32rpx}.address-main text{margin-left:12rpx;padding:4rpx 10rpx;border-radius:6rpx;background:#dceaff;color:#164e9c;font-size:20rpx;font-weight:800}.address-detail{margin-top:12rpx;color:#52657f;line-height:1.55}.text-button{width:auto;height:auto;margin:0;padding:0;background:transparent;color:#155eef;font-size:25rpx;line-height:1.5}.address-card>.text-button{position:absolute;right:30rpx;top:32rpx}.add-address{height:88rpx;line-height:88rpx}.fields{padding:0 28rpx}.field{display:flex;align-items:center;justify-content:space-between;padding:28rpx 0;border-bottom:1rpx solid #d9e4f2}.fields picker:last-child .field{border-bottom:0}.field text{color:#5e6f89}.field strong{font-size:27rpx}.summary-list{border-top:1rpx solid #d9e4f2}.summary-list>view{display:flex;justify-content:space-between;padding:22rpx 4rpx;border-bottom:1rpx solid #e1e9f4}.summary-list strong{color:#52657f}.edit-items{margin-top:16rpx}.optional{color:#7b8aa0;font-size:22rpx;font-weight:400}.remark{width:100%;min-height:150rpx;padding:24rpx;border:1rpx solid #d9e4f2;border-radius:18rpx;background:#fff;box-sizing:border-box}.notice{margin-top:22rpx;color:#6f7f95;font-size:22rpx}.submit-bar{position:fixed;z-index:20;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:space-between;padding:18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid #d9e4f2;background:#fff}.submit-bar text,.submit-bar strong{display:block}.submit-bar text{color:#5e6f89;font-size:22rpx}.submit-bar strong{margin-top:4rpx;font-size:30rpx}.submit-bar button{width:260rpx;height:80rpx;margin:0;line-height:80rpx}
.deal-summary{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx;padding:24rpx 26rpx;border-radius:20rpx;background:#e8f1ff;color:#172b4d}.deal-summary text,.deal-summary>view:first-child strong{display:block}.deal-summary text{color:#155eef;font-size:21rpx;font-weight:800}.deal-summary>view:first-child strong{max-width:400rpx;margin-top:5rpx;font-size:26rpx}.deal-summary>view:last-child{color:#52657f;font-size:22rpx}.deal-summary>view:last-child strong{color:#155eef;font-size:30rpx}
.deal-summary{gap:16rpx;flex-wrap:wrap}.deal-summary>view{min-width:0}.deal-summary>view:first-child strong{max-width:100%;overflow-wrap:anywhere}.submit-bar{gap:12rpx}.submit-bar>view{min-width:0}.submit-bar strong{overflow-wrap:anywhere}.submit-bar button{flex-shrink:0;max-width:42%}
