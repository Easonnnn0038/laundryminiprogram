.appointment-page{padding-bottom:210rpx}.heading{display:flex;align-items:flex-end;justify-content:space-between}.step{color:#8b948f;font-family:ui-monospace,monospace;font-size:23rpx}.address-card{position:relative;padding:30rpx}.address-main{padding-right:170rpx}.address-main strong{font-size:32rpx}.address-main text{margin-left:12rpx;padding:4rpx 10rpx;border-radius:6rpx;background:#f4cf66;color:#4e3a00;font-size:20rpx;font-weight:800}.address-detail{margin-top:12rpx;color:#596a63;line-height:1.55}.text-button{width:auto;height:auto;margin:0;padding:0;background:transparent;color:#8b641e;font-size:25rpx;line-height:1.5}.address-card>.text-button{position:absolute;right:30rpx;top:32rpx}.add-address{height:88rpx;line-height:88rpx}.fields{padding:0 28rpx}.field{display:flex;align-items:center;justify-content:space-between;padding:28rpx 0;border-bottom:1rpx solid #e0e4df}.fields picker:last-child .field{border-bottom:0}.field text{color:#65736d}.field strong{font-size:27rpx}.summary-list{border-top:1rpx solid #d7ddd8}.summary-list>view{display:flex;justify-content:space-between;padding:22rpx 4rpx;border-bottom:1rpx solid #dfe3df}.summary-list strong{color:#52645d}.edit-items{margin-top:16rpx}.optional{color:#89928d;font-size:22rpx;font-weight:400}.remark{width:100%;min-height:150rpx;padding:24rpx;border:1rpx solid #d7ddd8;border-radius:18rpx;background:#fffefa;box-sizing:border-box}.notice{margin-top:22rpx;color:#7b8681;font-size:22rpx}.submit-bar{position:fixed;z-index:20;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:space-between;padding:18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));border-top:1rpx solid #e0e4df;background:#fffefa}.submit-bar text,.submit-bar strong{display:block}.submit-bar text{color:#65736d;font-size:22rpx}.submit-bar strong{margin-top:4rpx;font-size:30rpx}.submit-bar button{width:260rpx;height:80rpx;margin:0;line-height:80rpx}
