<view class="page appointment-page">
  <view class="heading"><view><view class="title">确认预约</view><view class="subtitle">确认上门信息后即可提交</view></view><view class="step">03 / 03</view></view>
  <view wx:if="{{error}}" class="error">{{error}}<button class="retry" bindtap="load">重试读取</button></view>
  <view wx:if="{{loading}}" class="empty">正在读取联系人…</view>
  <block wx:else>
    <view class="section-title">联系人与地址</view>
    <view wx:if="{{addresses.length}}" class="surface address-card">
      <picker range="{{addresses}}" range-key="detailAddress" value="{{addressIndex}}" bindchange="selectAddress">
        <view class="address-main"><view><strong>{{addresses[addressIndex].contactName}}</strong><text wx:if="{{addresses[addressIndex].isDefault}}">默认</text></view><view class="address-detail">{{addresses[addressIndex].detailAddress}}</view></view>
      </picker>
      <button class="text-button" bindtap="manageAddresses">管理地址</button>
    </view>
    <button wx:else class="secondary add-address" bindtap="manageAddresses">＋ 新增联系人和地址</button>

    <view class="section-title">上门时间</view>
    <view class="surface fields">
      <picker mode="date" value="{{appointmentDate}}" start="{{appointmentDate}}" bindchange="selectDate"><view class="field"><text>预约日期</text><strong>{{appointmentDate}}　›</strong></view></picker>
      <picker range="{{slots}}" value="{{slotIndex}}" bindchange="selectSlot"><view class="field"><text>时间段</text><strong>{{slots[slotIndex]}}　›</strong></view></picker>
    </view>

    <view class="section-title">衣物清单</view>
    <view wx:if="{{deal}}" class="deal-summary"><view><text>使用团购套餐</text><strong>{{deal.name}}</strong></view><view>参考价 <strong>¥{{deal.price}}</strong></view></view>
    <view wx:if="{{deal}}" class="surface fields"><view class="field"><text>团购券码</text><input value="{{voucherCode}}" placeholder="请输入券码" maxlength="80" bindinput="inputVoucher" /></view></view>
    <view class="summary-list">
      <view wx:for="{{selected}}" wx:key="id"><text>{{item.name}} × {{item.quantity}}</text><strong>¥{{item.price}}</strong></view>
      <button class="text-button edit-items" bindtap="backToCatalog">返回修改</button>
    </view>

    <view class="section-title">备注 <text class="optional">选填</text></view>
    <textarea class="remark" value="{{remark}}" placeholder="如门禁、取衣要求等" maxlength="400" bindinput="inputRemark" />
    <view class="notice">{{deal ? '门店将核对团购套餐适用范围和核销方式，确认后按约定上门。' : '提交的是预估清单，实际费用将在门店验衣后确认。'}}</view>

    <view class="submit-bar"><view><text>{{count}} 件</text><strong>{{deal ? '团购参考 ¥' + deal.price : '预估 ¥' + total}}</strong></view><button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">提交预约</button></view>
  </block>
</view>
